<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="Brush.Window">#0B1016</SolidColorBrush>
    <SolidColorBrush x:Key="Brush.Sidebar">#0D141B</SolidColorBrush>
    <SolidColorBrush x:Key="Brush.Main">#101820</SolidColorBrush>
    <SolidColorBrush x:Key="Brush.RightPanel">#0D151D</SolidColorBrush>
    <SolidColorBrush x:Key="Brush.Surface">#141F29</SolidColorBrush>
    <SolidColorBrush x:Key="Brush.Elevated">#182631</SolidColorBrush>
    <SolidColorBrush x:Key="Brush.Border">#23313D</SolidColorBrush>
    <SolidColorBrush x:Key="Brush.Primary">#59C7C4</SolidColorBrush>
    <SolidColorBrush x:Key="Brush.PrimaryHover">#6ED5D1</SolidColorBrush>
    <SolidColorBrush x:Key="Brush.Text">#EEF3F6</SolidColorBrush>
    <SolidColorBrush x:Key="Brush.TextSecondary">#8C9BA8</SolidColorBrush>
    <SolidColorBrush x:Key="Brush.Success">#66C28A</SolidColorBrush>
    <SolidColorBrush x:Key="Brush.Warning">#D7A45B</SolidColorBrush>
    <SolidColorBrush x:Key="Brush.Error">#DF7B71</SolidColorBrush>

    <StreamGeometry x:Key="Icon.Home">M3 10 L12 3 L21 10 L21 21 L14 21 L14 14 L10 14 L10 21 L3 21 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Package">M3 6 L12 2 L21 6 L12 10 Z M3 8 L11 12 L11 22 L3 18 Z M13 12 L21 8 L21 18 L13 22 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Compass">M12 2 L16 8 L22 12 L16 16 L12 22 L8 16 L2 12 L8 8 Z M12 8 L16 12 L12 16 L8 12 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Layers">M12 2 L22 7 L12 12 L2 7 Z M2 12 L12 17 L22 12 L22 16 L12 21 L2 16 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Tools">M4 3 L8 7 L6 9 L2 5 Z M9 8 L21 20 L18 23 L6 11 Z M16 3 L21 3 L21 8 L18 11 L15 8 L18 5 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Settings">M4 5 L20 5 L20 8 L4 8 Z M8 3 L11 3 L11 10 L8 10 Z M4 16 L20 16 L20 19 L4 19 Z M14 14 L17 14 L17 21 L14 21 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Config">M4 5 L20 5 L20 7 L4 7 Z M8 2 L11 2 L11 10 L8 10 Z M4 12 L20 12 L20 14 L4 14 Z M14 9 L17 9 L17 17 L14 17 Z M4 19 L20 19 L20 21 L4 21 Z M6 16 L9 16 L9 24 L6 24 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Save">M4 3 L18 3 L22 7 L22 21 L3 21 L3 3 Z M7 5 L16 5 L16 10 L7 10 Z M7 14 L18 14 L18 19 L7 19 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Play">M7 4 L20 12 L7 20 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Folder">M2 5 L9 5 L11 8 L22 8 L20 20 L2 20 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.File">M5 2 L15 2 L20 7 L20 22 L5 22 Z M15 2 L15 8 L20 8 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Refresh">M4 7 L9 3 L9 6 L15 6 L15 9 L9 9 L9 12 Z M20 17 L15 21 L15 18 L9 18 L9 15 L15 15 L15 12 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Search">M10 3 L14 3 L18 7 L18 13 L16 16 L22 22 L19 24 L13 18 L10 19 L6 18 L3 15 L2 11 L3 7 L6 4 Z M10 6 L7 7 L5 10 L6 14 L9 16 L13 16 L16 13 L16 9 L13 6 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Check">M3 12 L8 17 L21 4 L23 7 L8 22 L1 15 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Warning">M12 2 L23 22 L1 22 Z M11 8 L13 8 L13 15 L11 15 Z M11 18 L13 18 L13 20 L11 20 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Chevron">M7 9 L12 14 L17 9 L19 11 L12 18 L5 11 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Download">M11 3 L13 3 L13 14 L17 10 L19 12 L12 19 L5 12 L7 10 L11 14 Z M4 21 L20 21 L20 23 L4 23 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Trash">M5 7 L19 7 L18 22 L6 22 Z M8 10 L10 10 L10 19 L8 19 Z M14 10 L16 10 L16 19 L14 19 Z M8 3 L16 3 L17 5 L21 5 L21 7 L3 7 L3 5 L7 5 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.External">M13 3 L21 3 L21 11 L18 11 L18 8 L11 15 L9 13 L16 6 L13 6 Z M4 6 L11 6 L11 9 L7 9 L7 19 L17 19 L17 15 L20 15 L20 22 L4 22 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Archive">M3 4 L21 4 L21 8 L3 8 Z M5 10 L19 10 L19 21 L5 21 Z M9 13 L15 13 L15 16 L9 16 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Activity">M2 13 L7 13 L10 6 L14 19 L17 12 L22 12 L22 15 L19 15 L14 23 L10 12 L9 16 L2 16 Z</StreamGeometry>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Brush.Window}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, sans-serif" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="LetterSpacing" Value="1.2" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="18" />
  </Style>

  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,9" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
    <Setter Property="Foreground" Value="#081316" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.PrimaryHover}" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="14,11" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.nav:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
  </Style>
  <Style Selector="Button.quick">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="8,8" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.quick:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource Brush.Elevated}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="8,3" />
  </Style>
  <Style Selector="TextBlock.badgeText">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
</Styles>
