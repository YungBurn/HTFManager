<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HTFManager.App.Views.Panels.GameControlPanel">
  <Border Background="{DynamicResource Brush.RightPanel}"
          BorderBrush="{DynamicResource Brush.Border}"
          BorderThickness="1,0,0,0">
    <ScrollViewer>
      <StackPanel Margin="18,22" Spacing="18">
        <StackPanel Spacing="7">
          <TextBlock Classes="section" Text="{DynamicResource Right.Game}" />
          <TextBlock Text="How to Fish" FontSize="20" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse x:Name="GameDot" Width="7" Height="7" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center" />
            <TextBlock x:Name="GameStateText" Classes="secondary" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock x:Name="GameVersionText" Classes="secondary" FontSize="11" />
        </StackPanel>

        <Button x:Name="PlayButton" Classes="primary" Height="50" Click="Play_Click">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
            <PathIcon Data="{StaticResource Icon.Play}" Width="16" Height="16" />
            <TextBlock x:Name="PlayText" Text="{DynamicResource Right.Play}" FontWeight="SemiBold" />
          </StackPanel>
        </Button>

        <StackPanel Spacing="7">
          <TextBlock Classes="section" Text="{DynamicResource Right.Profile}" />
          <ComboBox x:Name="ProfileCombo" SelectionChanged="ProfileCombo_SelectionChanged" />
        </StackPanel>

        <Border Height="1" Background="{DynamicResource Brush.Border}" />

        <StackPanel Spacing="4">
          <TextBlock Classes="section" Text="{DynamicResource Right.QuickActions}" Margin="0,0,0,4" />
          <Button Classes="quick" Click="BrowseGame_Click">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <PathIcon Data="{StaticResource Icon.Folder}" Width="16" Height="16" />
              <TextBlock Text="{DynamicResource Right.BrowseGame}" />
            </StackPanel>
          </Button>
          <Button x:Name="OpenBepModsButton" Classes="quick" Click="OpenMods_Click">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <PathIcon Data="{StaticResource Icon.Package}" Width="16" Height="16" />
              <TextBlock Text="{DynamicResource Right.OpenBepMods}" />
            </StackPanel>
          </Button>
          <Button x:Name="OpenMelonModsButton" Classes="quick" Click="OpenMelonMods_Click">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <PathIcon Data="{StaticResource Icon.Package}" Width="16" Height="16" />
              <TextBlock Text="{DynamicResource Right.OpenMelonMods}" />
            </StackPanel>
          </Button>
          <Button x:Name="OpenMelonPluginsButton" Classes="quick" Click="OpenMelonPlugins_Click">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <PathIcon Data="{StaticResource Icon.Package}" Width="16" Height="16" />
              <TextBlock Text="{DynamicResource Right.OpenMelonPlugins}" />
            </StackPanel>
          </Button>
          <Button x:Name="OpenConfigButton" Classes="quick" Click="OpenConfig_Click">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <PathIcon Data="{StaticResource Icon.Settings}" Width="16" Height="16" />
              <TextBlock Text="{DynamicResource Right.OpenConfig}" />
            </StackPanel>
          </Button>
          <Button x:Name="ViewBepLogButton" Classes="quick" Click="ViewLog_Click">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <PathIcon Data="{StaticResource Icon.File}" Width="16" Height="16" />
              <TextBlock Text="{DynamicResource Right.ViewBepLog}" />
            </StackPanel>
          </Button>
          <Button x:Name="ViewMelonLogsButton" Classes="quick" Click="ViewMelonLogs_Click">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <PathIcon Data="{StaticResource Icon.File}" Width="16" Height="16" />
              <TextBlock Text="{DynamicResource Right.ViewMelonLogs}" />
            </StackPanel>
          </Button>
          <Button Classes="quick" Click="Refresh_Click">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <PathIcon Data="{StaticResource Icon.Refresh}" Width="16" Height="16" />
              <TextBlock Text="{DynamicResource Right.Refresh}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <Border Height="1" Background="{DynamicResource Brush.Border}" />

        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="{DynamicResource Right.Activity}" />
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
            <PathIcon Data="{StaticResource Icon.Activity}" Width="15" Height="15" Foreground="{DynamicResource Brush.Primary}" VerticalAlignment="Top" Margin="0,2,0,0" />
            <TextBlock x:Name="ActivityText" Grid.Column="1" Classes="secondary" Text="{DynamicResource Right.NoActivity}" TextWrapping="Wrap" FontSize="11" />
          </Grid>
        </StackPanel>

        <Border Height="1" Background="{DynamicResource Brush.Border}" />

        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="{DynamicResource Right.Environment}" />
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="5">
            <TextBlock Text="{DynamicResource Right.GameState}" Classes="secondary" />
            <TextBlock x:Name="EnvGameText" Grid.Column="1" />
            <TextBlock Grid.Row="1" Text="BepInEx" Classes="secondary" />
            <TextBlock x:Name="EnvBepText" Grid.Row="1" Grid.Column="1" />
            <TextBlock Grid.Row="2" Text="MelonLoader" Classes="secondary" />
            <TextBlock x:Name="EnvMelonText" Grid.Row="2" Grid.Column="1" />
            <TextBlock Grid.Row="3" Text="{DynamicResource Right.ModCount}" Classes="secondary" />
            <TextBlock x:Name="EnvModsText" Grid.Row="3" Grid.Column="1" />
          </Grid>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
