<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HTFManager.App.Views.Discover.DiscoverView">
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="30,28">
    <StackPanel Spacing="5">
      <TextBlock Classes="h1" Text="{DynamicResource Discover.Title}" />
      <TextBlock Classes="secondary" Text="{DynamicResource Discover.Subtitle}" TextWrapping="Wrap" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,170,180,Auto" Margin="0,22,0,12" ColumnSpacing="10">
      <TextBox x:Name="SearchBox" PlaceholderText="{DynamicResource Discover.Search}" TextChanged="SearchBox_TextChanged" />
      <ComboBox x:Name="FilterCombo" Grid.Column="1" SelectionChanged="FilterCombo_SelectionChanged" />
      <ComboBox x:Name="SortCombo" Grid.Column="2" SelectionChanged="SortCombo_SelectionChanged" />
      <Button Grid.Column="3" Classes="secondary" Click="Refresh_Click">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Data="{StaticResource Icon.Refresh}" Width="15" Height="15" />
          <TextBlock Text="{DynamicResource Discover.Refresh}" />
        </StackPanel>
      </Button>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="2,0,2,12">
      <TextBlock x:Name="CatalogStatusText" Classes="secondary" FontSize="11" />
      <ProgressBar x:Name="LoadingBar" Grid.Column="1" Width="110" Height="3" IsIndeterminate="True" IsVisible="False" />
    </Grid>

    <ScrollViewer Grid.Row="3">
      <WrapPanel x:Name="PackageList" HorizontalAlignment="Left" />
    </ScrollViewer>
  </Grid>
</UserControl>
