<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HTFManager.App.Views.Dialogs.ProfileHealthDialog"
        Width="860" Height="680" MinWidth="760" MinHeight="560"
        CanResize="True" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        Icon="/Assets/AppIcon.ico"
        Title="HTF Manager">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <StackPanel Margin="26,24,26,16" Spacing="5">
      <TextBlock Text="{DynamicResource Health.Title}" FontSize="22" FontWeight="SemiBold" />
      <TextBlock x:Name="ProfileNameText" Classes="secondary" />
      <TextBlock Text="{DynamicResource Health.Subtitle}" Classes="secondary" TextWrapping="Wrap" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="26,0,26,16" ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
      <Border Classes="card" Padding="12"><StackPanel Spacing="3"><TextBlock Text="{DynamicResource Health.Healthy}" Classes="secondary" FontSize="10"/><TextBlock x:Name="HealthyCountText" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
      <Border Grid.Column="1" Classes="card" Padding="12"><StackPanel Spacing="3"><TextBlock Text="{DynamicResource Health.Missing}" Classes="secondary" FontSize="10"/><TextBlock x:Name="MissingCountText" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
      <Border Grid.Column="2" Classes="card" Padding="12"><StackPanel Spacing="3"><TextBlock Text="{DynamicResource Health.VersionMismatch}" Classes="secondary" FontSize="10"/><TextBlock x:Name="VersionCountText" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
      <Border Grid.Column="3" Classes="card" Padding="12"><StackPanel Spacing="3"><TextBlock Text="{DynamicResource Health.Uncertain}" Classes="secondary" FontSize="10"/><TextBlock x:Name="UncertainCountText" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
    </Grid>

    <Border Grid.Row="2" Margin="26,0,26,18" Classes="card" Padding="10">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ItemsList" Spacing="8" />
      </ScrollViewer>
    </Border>

    <Border Grid.Row="3" Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="22,14">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
        <TextBlock x:Name="FooterText" Classes="secondary" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button x:Name="RestoreButton" Grid.Column="1" Classes="primary" Click="Restore_Click">
          <TextBlock Text="{DynamicResource Profiles.RestoreMissing}" />
        </Button>
        <Button Grid.Column="2" Classes="secondary" Click="Close_Click" MinWidth="88">
          <TextBlock Text="{DynamicResource Common.Close}" />
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
