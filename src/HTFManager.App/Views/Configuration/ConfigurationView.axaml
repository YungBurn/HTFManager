<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HTFManager.App.Views.Configuration.ConfigurationView">
  <Grid>
    <Grid Margin="30,28" RowDefinitions="Auto,*" RowSpacing="18">
      <StackPanel Spacing="5">
        <TextBlock Classes="h1" Text="{DynamicResource Config.Title}" />
        <TextBlock Classes="secondary" Text="{DynamicResource Config.Subtitle}" TextWrapping="Wrap" />
      </StackPanel>

      <Grid Grid.Row="1" ColumnDefinitions="292,*" ColumnSpacing="14" MinHeight="480">
        <Border Classes="card" Padding="14">
          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
            <TextBox x:Name="SearchBox" PlaceholderText="{DynamicResource Config.Search}" TextChanged="SearchBox_TextChanged" />
            <ComboBox x:Name="LoaderFilterCombo" Grid.Row="1" SelectionChanged="LoaderFilter_SelectionChanged" />
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="ConfigurationList" Spacing="8" />
            </ScrollViewer>
          </Grid>
        </Border>

        <Border Grid.Column="1" Classes="card" Padding="18">
          <Grid>
            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="420">
              <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource Brush.Elevated}" HorizontalAlignment="Center">
                <PathIcon Data="{StaticResource Icon.Config}" Width="22" Height="22" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{DynamicResource Config.EmptyTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="{DynamicResource Config.EmptyHint}" Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>

            <Grid x:Name="DetailPanel" IsVisible="False" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <StackPanel Spacing="5">
                  <TextBlock x:Name="ConfigTitleText" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <WrapPanel x:Name="HeaderBadges" />
                  <TextBlock x:Name="ConfigPathText" Classes="secondary" FontSize="10" TextWrapping="Wrap" />
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                  <Button Classes="secondary" Margin="0,0,7,7" Click="OpenFile_Click">
                    <TextBlock Text="{DynamicResource Config.OpenFile}" />
                  </Button>
                  <Button Classes="secondary" Margin="0,0,7,7" Click="OpenFolder_Click">
                    <TextBlock Text="{DynamicResource Config.OpenFolder}" />
                  </Button>
                  <Button x:Name="RestoreButton" Classes="secondary" Margin="0,0,0,7" Click="Restore_Click">
                    <TextBlock x:Name="RestoreButtonText" Text="{DynamicResource Config.Restore}" />
                  </Button>
                </WrapPanel>
              </Grid>

              <Grid Grid.Row="1" ColumnDefinitions="Auto,220,*" ColumnSpacing="10">
                <TextBlock Text="{DynamicResource Config.Section}" Classes="secondary" VerticalAlignment="Center" />
                <ComboBox x:Name="SectionFilterCombo" Grid.Column="1" SelectionChanged="SectionFilter_SelectionChanged" />
                <TextBlock x:Name="BackupCountText" Grid.Column="2" Classes="secondary" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>

              <Border Grid.Row="2" Background="{DynamicResource Brush.Elevated}" CornerRadius="8" Padding="10,8">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <PathIcon Data="{StaticResource Icon.Warning}" Width="13" Height="13" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center" />
                  <TextBlock x:Name="ConfigHintText" Grid.Column="1" Text="{DynamicResource Config.RestartHint}" Classes="secondary" FontSize="10" TextWrapping="Wrap" />
                </Grid>
              </Border>

              <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="EntryList" Spacing="9" />
              </ScrollViewer>

              <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="9">
                <TextBlock x:Name="DirtyText" Classes="secondary" VerticalAlignment="Center" />
                <Button x:Name="RevertButton" Grid.Column="1" Classes="secondary" Click="Revert_Click">
                  <TextBlock Text="{DynamicResource Config.Revert}" />
                </Button>
                <Button x:Name="SaveButton" Grid.Column="2" Classes="primary" Click="Save_Click">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <PathIcon Data="{StaticResource Icon.Save}" Width="14" Height="14" />
                    <TextBlock Text="{DynamicResource Common.Save}" />
                  </StackPanel>
                </Button>
              </Grid>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- In-page safety acknowledgement. This is intentionally not a separate Window. -->
    <Border x:Name="SafetyOverlay" ZIndex="20" IsVisible="False" Background="#D90B1016">
      <Border Classes="card" MinWidth="440" MaxWidth="620" Padding="24"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="1">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource Brush.Elevated}">
              <PathIcon Data="{StaticResource Icon.Warning}" Width="20" Height="20"
                        Foreground="{DynamicResource Brush.Warning}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="5">
              <TextBlock Text="{DynamicResource Config.Safety.Title}" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource Config.Safety.Subtitle}" Classes="secondary" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>

          <Border Background="{DynamicResource Brush.Elevated}" CornerRadius="8" Padding="14">
            <StackPanel Spacing="9">
              <TextBlock Text="{DynamicResource Config.Safety.Body1}" TextWrapping="Wrap" />
              <TextBlock Text="{DynamicResource Config.Safety.Body2}" TextWrapping="Wrap" />
              <TextBlock Text="{DynamicResource Config.Safety.Body3}" Classes="secondary" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <TextBlock Text="{DynamicResource Config.Safety.LocalOnly}" Classes="secondary" FontSize="10" TextWrapping="Wrap" />

          <Button Classes="primary" HorizontalAlignment="Right" Click="SafetyAcknowledge_Click">
            <TextBlock Text="{DynamicResource Config.Safety.Acknowledge}" />
          </Button>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
