<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HTFManager.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary />
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://HTFManager/Themes/Theme.axaml" />
  </Application.Styles>
</Application>
